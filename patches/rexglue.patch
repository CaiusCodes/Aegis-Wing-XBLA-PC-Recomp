+  if (g_packet_trace.size() < 100000) g_packet_trace.push_back(e);  // the title stopped reading
+}
+
+namespace rex::kernel::xam::netplay {
+void SetPacketTrace(bool on) {
+  g_packet_trace_on.store(on);
+  if (!on) {
+    std::lock_guard<std::mutex> lock(g_packet_trace_mutex);
+    g_packet_trace.clear();
