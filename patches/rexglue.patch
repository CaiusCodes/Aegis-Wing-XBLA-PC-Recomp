+void OnSessionCreated(uint32_t flags, uint32_t slots, uint8_t* session_info, uint8_t* nonce) {
+  if (!Enabled()) {
+    return;
+  }
+  if (!session_info) {
+    if (nonce) {
+      RandomBytes(nonce, 8);
+    }
+    return;
+  }
+  bool start_responder = false;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (flags & kSessionCreateHost) {
+      RandomBytes(session_info + kInfoKid, 8);
+      session_info[kInfoKid] = (session_info[kInfoKid] & 0x0F) | 0x80;  // XNET_XNKID_ONLINE_PEER
+      FillLocalXnAddr(session_info + kInfoHost);
+      RandomBytes(session_info + kInfoKey, 16);
+      std::memcpy(hosted_info.data(), session_info, kSessionInfoSize);
+      hosting = true;
+      joined = false;
+      session_slots = slots;
+      session_started = false;
+      start_responder = true;
+      REXKRNL_INFO("[netplay] hosting a Private Match (flags {:08X})", flags);
+    } else {
+      uint32_t host_ina;
+      std::memcpy(&host_ina, session_info + kInfoHost + kXnAddrIna, 4);
+      invite.pending = false;
+      joined = true;
+      seeking = false;
+      choices.clear();
+      REXKRNL_INFO("[netplay] joining the Private Match hosted at {} (flags {:08X})",
+                   FormatIPv4(host_ina), flags);
+    }
+    std::memcpy(current_kid.data(), session_info + kInfoKid, current_kid.size());
+    // The session nonce has to be the same on every PC in the match. It used
+    // to be random per PC, and a title that seeds anything from it (the
+    // co-op simulation runs on both machines and is checked for sync) would
+    // diverge from the first frame. The session ID is already shared - the
+    // host makes it and joiners receive it - so derive the nonce from that.
+    if (nonce) {
+      uint64_t mixed = 0x9E3779B97F4A7C15ull;
+      for (size_t i = 0; i < current_kid.size(); ++i) {
+        mixed = (mixed ^ current_kid[i]) * 0x100000001B3ull;
+      }
+      for (int i = 0; i < 8; ++i) {
+        nonce[i] = uint8_t(mixed >> (56 - 8 * i));
+      }
+      REXKRNL_INFO("[netplay] session nonce {:016X} (from the session ID)", mixed);
+    }
+  }
+  if (start_responder) {
+    StartResponder();
+  }
+}
