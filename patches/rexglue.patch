+// Clock sync (net_clock_sync). Two PCs' games run at slightly different
+// speeds - a fraction of a percent, which drifts a match seconds apart over ten
+// minutes, and is what made the other player zip about more and more as a
+// match went on. The joiner keeps its game at the host's pace.
+//
+// Timing packet arrivals cannot measure that: arrivals are read when the game
+// polls, once a frame, and a player who has nothing to say sends nothing, so
+// any rule for splitting pauses from lateness biases the estimate by more than
+// the error it is after. So both sides carry the truth instead: each gameplay
+// packet gets eight bytes on the end - "PDSY" and the sender's presented-frame
+// count - which the receiver strips before the game sees the packet. The host's
+// pace is then how far its count advanced between two arrivals ten seconds
+// apart; lateness and pauses only touch the two ends of that span.
+namespace {
+
+constexpr uint8_t kSyncMagic[4] = {'P', 'D', 'S', 'Y'};
+constexpr uint32_t kSyncTrailer = 8;
+
+uint64_t OwnFrameCount() {
+  auto* ks = rex::system::kernel_state();
+  if (!ks || !ks->emulator() || !ks->emulator()->graphics_system()) return 0;
+  return ks->emulator()->graphics_system()->guest_frame_count();
+}
+
+struct SyncState {
+  std::chrono::steady_clock::time_point last_seen{};
+  uint32_t last_host = 0;
+  bool have_last = false;
+  bool have_start = false;
+  std::chrono::steady_clock::time_point start_at{};
+  uint32_t host_start = 0;
+  uint64_t own_start = 0;
+  bool have_window = false;
+  std::chrono::steady_clock::time_point window_at{};
+  uint32_t host_window = 0;
+  uint64_t own_window = 0;
+  double scale = 1.0;
+  bool active = false;
+  int updates = 0;
+};
+std::mutex g_sync_mutex;
+SyncState g_sync;
+
+void SetGameSpeed(double scale) {
+  rex::cvar::SetFlagByName("guest_vblank_scale", fmt::format("{:.6f}", scale));
+}
+
+void ResetSync(const char* why) {
+  if (g_sync.active) {
+    SetGameSpeed(1.0);
+    REXLOG_INFO("[sync] {} - game speed back to normal", why);
+  }
+  g_sync = SyncState{};
+}
+
+}  // namespace
+
+// Outgoing: put this PC's frame count on the end of a gameplay packet.
+static bool ClockSyncTag(const uint8_t* buf, uint32_t len, std::vector<uint8_t>* out) {
+  if (!REXCVAR_GET(net_clock_sync) || len < 20) return false;
+  if (!rex::kernel::xam::netplay::Enabled()) return false;
+  const uint32_t count = uint32_t(OwnFrameCount());
+  out->assign(buf, buf + len);
+  out->insert(out->end(), kSyncMagic, kSyncMagic + 4);
+  out->push_back(uint8_t(count >> 24));
+  out->push_back(uint8_t(count >> 16));
+  out->push_back(uint8_t(count >> 8));
+  out->push_back(uint8_t(count));
+  return true;
+}
+
+// Incoming: take the trailer off (the game must never see it) and, on a
+// joiner, use the host's count to keep pace. Returns the packet's real length.
+static int ClockSyncReceive(uint8_t* buf, int len, uint32_t* peer_frame = nullptr) {
+  if (len < int(20 + kSyncTrailer)) return len;
+  const uint8_t* t = buf + len - kSyncTrailer;
+  if (std::memcmp(t, kSyncMagic, 4) != 0) return len;
+  const uint32_t host_count =
+      (uint32_t(t[4]) << 24) | (uint32_t(t[5]) << 16) | (uint32_t(t[6]) << 8) | uint32_t(t[7]);
+  if (peer_frame) *peer_frame = host_count;
+  len -= int(kSyncTrailer);
+  if (!REXCVAR_GET(net_clock_sync)) return len;
+
+  namespace netplay = rex::kernel::xam::netplay;
+  const auto now = std::chrono::steady_clock::now();
+  const uint64_t own = OwnFrameCount();
+  std::lock_guard<std::mutex> lock(g_sync_mutex);
+  if (!netplay::IsJoinedSession()) {
+    ResetSync("not joined to a match");  // the host keeps its own clock
+    return len;
+  }
+  // A fresh reference whenever the old one cannot be trusted: the first
+  // packet, a gap in gameplay traffic (a new match or a load), or the host's
+  // count jumping somewhere a running game cannot take it (a restart). The
+  // first version never re-anchored; after the host restarted it believed this
+  // PC was 15,693 frames ahead, pulled flat out for a whole match, and held it
+  // 0.33% too slow - the drift reversed rather than removed.
+  auto anchor = [&](const char* why) {
+    g_sync.have_start = true;
+    g_sync.start_at = now;
+    g_sync.host_start = host_count;
+    g_sync.own_start = own;
+    g_sync.have_window = true;
+    g_sync.window_at = now;
+    g_sync.host_window = host_count;
+    g_sync.own_window = own;
+    if (why) REXLOG_INFO("[sync] fresh reference ({}), keeping game speed {:+.3f}%", why,
+                         (g_sync.scale - 1.0) * 100.0);
+  };
+  const int32_t host_step = g_sync.have_last ? int32_t(host_count - g_sync.last_host) : 0;
+  const double quiet =
+      g_sync.have_last ? std::chrono::duration<double>(now - g_sync.last_seen).count() : 0.0;
+  g_sync.last_seen = now;
+  g_sync.last_host = host_count;
+  const bool first = !g_sync.have_last;
+  g_sync.have_last = true;
+  if (first || !g_sync.have_start) {
+    anchor(nullptr);
+    return len;
+  }
+  if (quiet > 3.0) {
+    anchor("gameplay resumed after a pause");
+    return len;
+  }
+  // Between two packets a few frames at most; far more, or backwards, means the
+  // host's game is not the one the reference was taken from.
+  if (host_step < -2 || host_step > 600) {
+    anchor("the host's frame count jumped");
+    return len;
+  }
+
+  const double span = std::chrono::duration<double>(now - g_sync.window_at).count();
+  if (span < 10.0) return len;
+
+  const double host_frames = double(int32_t(host_count - g_sync.host_window));
+  const double own_frames = double(int64_t(own - g_sync.own_window));
+  g_sync.window_at = now;
+  g_sync.host_window = host_count;
+  g_sync.own_window = own;
+  if (host_frames < span * 30.0 || own_frames < span * 30.0) return len;  // a pause or load
+
+  // How far this PC has run ahead of the host since the reference, in frames.
+  // Rate matching alone would hold that where it is; a small pull brings it
+  // back over the next half minute. Seconds of lead cannot be real drift -
+  // the reference is stale - so start again rather than act on it.
+  const double ahead = double(int64_t(own - g_sync.own_start)) -
+                       double(int32_t(host_count - g_sync.host_start));
+  if (std::fabs(ahead) > 300.0) {
+    anchor("the lead since the reference made no sense");
+    return len;
+  }
+  const double ratio = host_frames / own_frames;
+  if (!(ratio > 0.95 && ratio < 1.05)) return len;
+  const double gain = g_sync.updates == 0 ? 1.0 : 0.5;
+  double scale = g_sync.scale * (1.0 + gain * (ratio - 1.0));
+  const double pull = std::clamp(-ahead / (60.0 * 30.0), -0.002, 0.002);
+  scale *= 1.0 + pull;
+  scale = std::clamp(scale, 0.98, 1.02);
+  g_sync.scale = scale;
+  g_sync.active = true;
+  ++g_sync.updates;
+  SetGameSpeed(scale);
+  REXLOG_INFO("[sync] host {:.3f} frames/s, this PC {:.3f} ({:+.3f}%), {:+.1f} frames ahead of "
+              "the host - game speed now {:+.3f}%",
+              host_frames / span, own_frames / span, (own_frames / host_frames - 1.0) * 100.0,
+              ahead, (scale - 1.0) * 100.0);
+  return len;
+}
