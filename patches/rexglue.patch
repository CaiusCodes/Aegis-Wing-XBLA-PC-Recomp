+// Returns true when the packet has been taken over by the test link.
+bool SimHoldPacket(uintptr_t handle, const sockaddr_in& to, const uint8_t* data, uint32_t len) {
+  const int latency = int(REXCVAR_GET(net_sim_latency));
+  if (latency <= 0) {
+    return false;
+  }
+  const int jitter = int(REXCVAR_GET(net_sim_jitter));
+  const int loss = int(REXCVAR_GET(net_sim_loss));
+  static thread_local std::mt19937 rng(std::random_device{}());
+  if (loss > 0 && int(rng() % 100) < loss) {
+    return true;  // dropped on the way
+  }
+  const int burst = int(REXCVAR_GET(net_sim_burst_ms));
+  if (burst > 0 && len >= 20) {
+    // A hole in the stream: everything for burst ms, once every burst_every s.
+    const auto now = std::chrono::steady_clock::now();
+    static std::chrono::steady_clock::time_point next = now + std::chrono::seconds(5);
+    static std::chrono::steady_clock::time_point until{};
+    static std::mutex m;
+    std::lock_guard<std::mutex> lock(m);
+    if (now >= next) {
+      until = now + std::chrono::milliseconds(burst);
+      next = now + std::chrono::seconds(int(REXCVAR_GET(net_sim_burst_every)));
+      REXLOG_INFO("[sim] dropping everything for {} ms", burst);
+    }
+    if (now < until) return true;  // lost in the hole
+  }
+  int hold = latency;
+  if (jitter > 0) {
+    hold += int(rng() % uint32_t(jitter * 2 + 1)) - jitter;
+  }
+  if (hold < 0) {
+    hold = 0;
+  }
+  SimStartThread();
+  SimPacket packet;
+  packet.due = std::chrono::steady_clock::now() + std::chrono::milliseconds(hold);
+  packet.handle = handle;
+  packet.to = to;
+  packet.data.assign(data, data + len);
+  {
+    std::lock_guard<std::mutex> lock(g_sim_mutex);
+    g_sim_queue.push_back(std::move(packet));
+    // Packets that are due at the same moment keep the order they were sent
+    // in; a jittered one can fall behind a later packet, as on a real link.
+    std::stable_sort(g_sim_queue.begin(), g_sim_queue.end(),
+                     [](const SimPacket& a, const SimPacket& b) { return a.due < b.due; });
+  }
+  return true;
 }
 
