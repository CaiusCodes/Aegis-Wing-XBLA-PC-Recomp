+// Test link (net_sim_latency / net_sim_jitter / net_sim_loss): datagrams the
+// game sends are held here and put on the wire late, unevenly and sometimes
+// not at all, so two copies on one PC behave like two PCs over the internet.
+// Held on the way out rather than on the way in, so the game's own socket
+// polling still sees packets arrive normally.
+namespace {
+
+struct SimPacket {
+  std::chrono::steady_clock::time_point due;
+  uintptr_t handle;
+  sockaddr_in to;
+  std::vector<uint8_t> data;
+};
+
+std::mutex g_sim_mutex;
+std::deque<SimPacket> g_sim_queue;
+std::atomic<bool> g_sim_thread_started{false};
+
+void SimStartThread() {
+  bool expected = false;
+  if (!g_sim_thread_started.compare_exchange_strong(expected, true)) {
+    return;
+  }
+  std::thread([] {
+    for (;;) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+      const auto now = std::chrono::steady_clock::now();
+      for (;;) {
+        SimPacket packet;
+        {
+          std::lock_guard<std::mutex> lock(g_sim_mutex);
+          if (g_sim_queue.empty() || g_sim_queue.front().due > now) {
+            break;
+          }
+          packet = std::move(g_sim_queue.front());
+          g_sim_queue.pop_front();
+        }
+        ::sendto(packet.handle, reinterpret_cast<const char*>(packet.data.data()),
+                 int(packet.data.size()), 0, (const sockaddr*)&packet.to, sizeof(sockaddr_in));
+      }
+    }
+  }).detach();
+}
