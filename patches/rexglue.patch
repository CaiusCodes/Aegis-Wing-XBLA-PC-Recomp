+}  // namespace
+
+bool Enabled() {
+  return REXCVAR_GET(net_private_match);
+}
+
+bool WakesOnDemand() {
+  return REXCVAR_GET(net_lan_on_demand);
+}
+
+void SetEnabled(bool on) {
+  if (Enabled() == on) {
+    return;
+  }
+  rex::cvar::SetFlagByName("net_private_match", on ? "true" : "false");
+  // Sockets already bound, and this PC's own addresses, were worked out under
+  // the old answer: tell them to work it out again.
+  rex::system::NotifyNetplayChanged();
+  if (on) {
+    // The title asked for its notification listener while the game was still
+    // offline, so it never heard that the LIVE connection came up and would
+    // say "Connection to Xbox LIVE has been lost" as soon as it tried to
+    // host. Tell it now (the same notification xam_notify queues for a
+    // listener created while online play is already on).
+    constexpr uint32_t kLiveConnectionChanged = 0x02000001;
+    constexpr uint32_t kLogonConnectionEstablished = 0x001510F0;
+    REX_KERNEL_STATE()->BroadcastNotification(kLiveConnectionChanged,
+                                              kLogonConnectionEstablished);
+  }
+  REXKRNL_INFO("[netplay] online play switched {} from the menu", on ? "on" : "off");
+}
+
+void SetOnlineMode(bool on) {
+  if (online_mode.exchange(on) != on) {
+    rex::system::NotifyNetplayChanged();  // sockets and addresses follow the new route
+  }
+}
+
+bool OnlineMode() {
+  return online_mode;
+}
+
+void SetDirectTarget(const std::string& address) {
+  std::lock_guard<std::mutex> lock(direct_mutex);
+  direct_target = address;
+  REXKRNL_INFO("[netplay] Direct Connect to \"{}\"", address);
+}
+
+bool LiveOnline() {
+  // The title always sees a profile that can play online. That is only
+  // bookkeeping - no socket leaves loopback until the player hosts or picks
+  // LAN / Direct Connect (Enabled, SetEnabled) - but the title reads it when a
+  // menu opens: Co-Operative and Counter-Operative only go through the lobby
+  // (Match Type: Host / Join) when the profile is signed in to LIVE, and go
+  // straight to a local mission otherwise.
+  return true;
+}
+
+uint32_t ConfiguredAddress() {
+  uint32_t ina = 0;
+  if (!Enabled() || !ParseIPv4(REXCVAR_GET(net_address), &ina)) {
+    return 0;
+  }
+  return ina;
+}
+
+uint32_t LoopbackAddress() {
+  uint32_t ina = 0;
+  if (ParseIPv4(REXCVAR_GET(net_address), &ina) && (ntohl(ina) >> 24) == 127) {
+    return ina;
+  }
+  return htonl(INADDR_LOOPBACK);
+}
+
+// The identity the title sees does not depend on whether online play is on.
+// The title reads its XUID and gamertag once, early; if they changed later -
+// when the player picks an online match - it decides the profile signed out
+// and drops back to the title screen. The XUID also has to differ between
+// PCs, which the profile's own (a fixed default) does not.
+uint64_t PlayerXuid(uint64_t profile_xuid) {
+  if (!profile_xuid) {
+    return profile_xuid;
+  }
+  static const uint64_t xuid = [] {
+    // Stable per PC, and per net_address so two copies on one PC differ.
+    EnsureWinsock();
+    char host[256] = {};
+    gethostname(host, sizeof(host) - 1);
+    const std::string seed = std::string(host) + "|" + REXCVAR_GET(net_address) + "|" +
+                             REXCVAR_GET(net_player_name);
+    uint64_t hash = 0xCBF29CE484222325ull;  // FNV-1a
+    for (unsigned char c : seed) {
+      hash = (hash ^ c) * 0x100000001B3ull;
+    }
+    // An online-style XUID; bits 54-55 must stay clear (see UserProfile).
+    return 0x0009000000000000ull | (hash & 0x0000FFFFFFFFFFFFull);
+  }();
+  return xuid;
+}
+
+std::string PlayerName(const std::string& profile_name) {
+  return ConfiguredPlayerName(profile_name);
+}
+
+std::string ConfiguredPlayerName(const std::string& profile_name) {
+  std::string name = REXCVAR_GET(net_player_name);
+  if (name.empty()) {
+    const char* user = std::getenv("USERNAME");
+    if (!user) {
+      user = std::getenv("USER");
+    }
+    name = user ? user : "";
+  }
+  if (name.empty()) {
+    return profile_name;
+  }
+  if (name.size() > 15) {
+    name.resize(15);  // gamertag length
+  }
+  return name;
+}
+
+void RandomBytes(uint8_t* out, size_t size) {
+  static std::mutex mutex;
+  static std::mt19937_64 engine{std::random_device{}()};
+  std::lock_guard<std::mutex> lock(mutex);
+  for (size_t i = 0; i < size; ++i) {
+    out[i] = uint8_t(engine());
+  }
+}
+
+void FillLocalXnAddr(uint8_t* xnaddr) {
+  const Identity& self = Local();
+  std::memset(xnaddr, 0, kXnAddrSize);
+  std::memcpy(xnaddr + kXnAddrIna, &self.addresses[0], 4);
+  std::memcpy(xnaddr + kXnAddrInaOnline, &self.addresses[0], 4);
+  std::memcpy(xnaddr + kXnAddrEnet, self.enet, sizeof(self.enet));
+  WriteAddressList(xnaddr + kXnAddrOnline, self.addresses);
+}
+
+uint64_t MachineId(const uint8_t* xnaddr) {
+  return 0xFA00000000000000ull | EnetKey(xnaddr);
+}
+
+uint32_t XnAddrToInAddr(const uint8_t* xnaddr) {
+  const Identity& self = Local();
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  uint32_t chosen = 0;
+  auto known = reachable.find(EnetKey(xnaddr));
+  if (known != reachable.end()) {
+    chosen = known->second;
+  } else {
+    const auto candidates = Candidates(xnaddr);
+    for (uint32_t candidate : candidates) {
+      for (uint32_t own : self.addresses) {
+        if (!chosen && SameNetwork(candidate, own)) {
+          chosen = candidate;
+        }
+      }
+    }
+    if (!chosen) {
+      chosen = candidates.front();
+    }
+  }
+  auto& entry = peers[chosen];
+  std::memcpy(entry.data(), xnaddr, kXnAddrSize);
+  return chosen;
+}
+
+void InAddrToXnAddr(uint32_t ina, uint8_t* xnaddr) {
+  {
+    std::lock_guard<std::mutex> lock(peers_mutex);
+    auto it = peers.find(ina);
+    if (it != peers.end()) {
+      std::memcpy(xnaddr, it->second.data(), kXnAddrSize);
+      return;
+    }
+  }
+  const Identity& self = Local();
+  if (std::find(self.addresses.begin(), self.addresses.end(), ina) != self.addresses.end()) {
+    FillLocalXnAddr(xnaddr);
+    return;
+  }
+  // Unknown peer: describe it by its address alone.
+  std::memset(xnaddr, 0, kXnAddrSize);
+  std::memcpy(xnaddr + kXnAddrIna, &ina, 4);
+  std::memcpy(xnaddr + kXnAddrInaOnline, &ina, 4);
+  xnaddr[kXnAddrEnet] = 0x02;
+  xnaddr[kXnAddrEnet + 1] = 'P';
+  std::memcpy(xnaddr + kXnAddrEnet + 2, &ina, 4);
+  WriteAddressList(xnaddr + kXnAddrOnline, {ina});
+}
+
+void SetQosListen(const uint8_t* data, uint32_t size, uint32_t flags) {
+  constexpr uint32_t kListenSetData = 0x04;  // XNET_QOS_LISTEN_SET_DATA
+  constexpr uint32_t kListenRelease = 0x10;  // XNET_QOS_LISTEN_RELEASE
+  {
+    std::lock_guard<std::mutex> lock(qos_mutex);
+    if (flags & kListenRelease) {
+      qos_data.clear();
+    }
+    if ((flags & kListenSetData) && data) {
+      qos_data.assign(data, data + std::min<size_t>(size, kMaxQosData));
+    }
+  }
+  REXKRNL_INFO("[netplay] QoS listen (flags {:02X}, {} bytes of data)", flags, size);
+  if (Enabled()) {
+    StartResponder();
+  }
+}
+
+QosResult QosProbe(const uint8_t* xnaddr) {
+  QosResult result;
+  EnsureWinsock();
+  const uint32_t target_ina = XnAddrToInAddr(xnaddr);
+  if (RelayActive()) {
+    RelayInbox inbox;
+    uint8_t query[kQueryIdSize] = {};
+    PutBE32(query, kQosQueryMagic);
+    PutBE32(query + 4, kProtocolVersion);
+    FillLocalXnAddr(query + 8);
+    for (int attempt = 0; attempt < 3 && !result.contacted; ++attempt) {
+      const auto sent_at = std::chrono::steady_clock::now();
+      RelaySend(inbox.port(), target_ina, kDiscoveryPort, query, sizeof(query));
+      uint8_t answer[12 + kMaxQosData];
+      uint32_t from = 0;
+      const int received = inbox.Receive(500, answer, sizeof(answer), &from);
+      if (received < 12 || GetBE32(answer) != kQosAnswerMagic ||
+          GetBE32(answer + 4) != kProtocolVersion) {
+        continue;
+      }
+      const uint32_t size = std::min<uint32_t>(GetBE32(answer + 8), uint32_t(received - 12));
+      result.contacted = true;
+      result.rtt_ms = std::max<uint32_t>(
+          1, uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                          std::chrono::steady_clock::now() - sent_at)
+                          .count()));
+      result.data.assign(answer + 12, answer + 12 + size);
+    }
+    REXKRNL_INFO("[netplay] QoS probe of {} through the online server: {}",
+                 FormatIPv4(target_ina),
+                 result.contacted ? "answered in " + std::to_string(result.rtt_ms) + " ms"
+                                  : std::string("no answer"));
+    return result;
+  }
+  socket_t s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (s == kNoSocket) {
+    return result;
+  }
+  sockaddr_in local = {};
+  local.sin_family = AF_INET;
+  local.sin_addr.s_addr = ConfiguredAddress();  // 0 = any address
+  bind(s, reinterpret_cast<sockaddr*>(&local), sizeof(local));
+  sockaddr_in target = {};
+  target.sin_family = AF_INET;
+  target.sin_port = htons(kDiscoveryPort);
+  target.sin_addr.s_addr = target_ina;
+  uint8_t query[kQueryIdSize] = {};
+  PutBE32(query, kQosQueryMagic);
+  PutBE32(query + 4, kProtocolVersion);
+  FillLocalXnAddr(query + 8);
+  for (int attempt = 0; attempt < 3 && !result.contacted; ++attempt) {
+    const auto sent_at = std::chrono::steady_clock::now();
+    sendto(s, reinterpret_cast<const char*>(query), sizeof(query), 0,
+           reinterpret_cast<const sockaddr*>(&target), sizeof(target));
+    fd_set readable;
+    FD_ZERO(&readable);
+    FD_SET(s, &readable);
+    timeval timeout = {0, 250 * 1000};
+    if (select(int(s + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+      continue;
+    }
+    uint8_t answer[12 + kMaxQosData];
+    const int received =
+        recvfrom(s, reinterpret_cast<char*>(answer), sizeof(answer), 0, nullptr, nullptr);
+    if (received < 12 || GetBE32(answer) != kQosAnswerMagic ||
+        GetBE32(answer + 4) != kProtocolVersion) {
+      continue;
+    }
+    const uint32_t size = std::min<uint32_t>(GetBE32(answer + 8), uint32_t(received - 12));
+    result.contacted = true;
+    result.rtt_ms = std::max<uint32_t>(
+        1, uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                        std::chrono::steady_clock::now() - sent_at)
+                        .count()));
+    result.data.assign(answer + 12, answer + 12 + size);
+  }
+  CloseSocket(s);
+  REXKRNL_INFO("[netplay] QoS probe of {}: {}", FormatIPv4(target_ina),
+               result.contacted ? "answered in " + std::to_string(result.rtt_ms) + " ms with " +
+                                      std::to_string(result.data.size()) + " bytes"
+                                : std::string("no answer"));
+  return result;
+}
