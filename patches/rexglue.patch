+std::vector<LanMatch> SearchLanMatches() {
+  std::vector<LanMatch> result;
+  if (!Enabled()) {
+    return result;
+  }
+  // The browse search: it collects every answer (rather than joining the
+  // first) and leaves this PC's own hosted match answering other searches.
+  Search(0, true);
+  std::lock_guard<std::mutex> lock(session_mutex);
+  for (const Candidate& c : browse_results) {
+    LanMatch m;
+    std::memcpy(m.session_info, c.info.data(), kSessionInfoSize);
+    m.host_name = c.name;
+    m.host_xuid = c.host_xuid;
+    m.address = FormatIPv4(c.host_ina);
+    m.players = c.players;
+    m.slots = c.max_players;
+    m.in_progress = c.in_progress;
+    m.ping_ms = c.ping_ms;
+    result.push_back(std::move(m));
+  }
+  return result;
+}
+
+bool BrowseJoin(size_t index, uint32_t user_index) {
+  Candidate match;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (index >= browse_results.size()) {
+      return false;
+    }
+    match = browse_results[index];
+    // The lobby the title opens for the join is a host session; it stays
+    // quiet until the join has happened.
+    seeking = true;
+    AcceptLocked(match, user_index);
+  }
+  AnnounceJoin(match);
+  REX_KERNEL_STATE()->BroadcastNotification(kNotificationInviteAccepted, user_index);
+  return true;
+}
