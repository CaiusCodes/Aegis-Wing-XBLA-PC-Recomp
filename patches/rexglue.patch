new file mode 100644
index 0000000000000000000000000000000000000000..7fc984d342abd1c9930f0dee53a673ae3fc08d4a
--- /dev/null
+++ b/src/kernel/xam/local_leaderboards.cpp
@@ -0,0 +1,552 @@
+/**
+ * @file        kernel/xam/local_leaderboards.cpp
+ * @brief       Offline Xbox LIVE leaderboards (see local_leaderboards.h).
+ *
+ * @license     BSD 3-Clause License
+ *              See LICENSE file in the project root for full license text.
+ */
+
+#include <rex/kernel/xam/local_leaderboards.h>
+#include <rex/kernel/xam/netplay.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+
+#include <fmt/format.h>
+#include <rex/logging.h>
+#include <rex/memory.h>
+#include <rex/runtime.h>
+#include <rex/system/kernel_state.h>
+#include <rex/system/util/xdbf_utils.h>
+#include <rex/system/xam/user_profile.h>
+
+namespace rex::kernel::xam::leaderboards {
+namespace {
+
+// XUSER_DATA types.
+constexpr uint8_t kTypeInt32 = 1;
+constexpr uint8_t kTypeInt64 = 2;
+constexpr uint8_t kTypeDouble = 3;
+constexpr uint8_t kTypeUnicode = 4;
+constexpr uint8_t kTypeFloat = 5;
+constexpr uint8_t kTypeBinary = 6;
+constexpr uint8_t kTypeNull = 0xFF;
+
+// Reserved column attributes.
+constexpr uint16_t kAttributeRank = 0xFFFF;
+constexpr uint16_t kAttributeRating = 0xFFFE;
+
+// Guest structure sizes: XUSER_STATS_SPEC, XUSER_STATS_READ_RESULTS,
+// XUSER_STATS_VIEW, XUSER_STATS_ROW (8-byte aligned, 16-char gamertag) and
+// XUSER_STATS_COLUMN (the XUSER_DATA value sits at +16).
+constexpr uint32_t kSpecSize = 136;
+constexpr uint32_t kMaxSpecColumns = 64;
+constexpr uint32_t kHeaderSize = 8;
+constexpr uint32_t kViewSize = 16;
+constexpr uint32_t kRowSize = 48;
+constexpr uint32_t kColumnSize = 24;
+constexpr size_t kGamertagSize = 16;
+
+constexpr size_t kMaxEntriesPerView = 100;
+constexpr uint32_t kXvc2Magic = 0x58564332;  // "XVC2"
+constexpr uint32_t kXpbmMagic = 0x5850424D;  // "XPBM"
+
+uint32_t ReadBe32(const uint8_t* p) { return memory::load_and_swap<uint32_t>(p); }
+uint16_t ReadBe16(const uint8_t* p) { return memory::load_and_swap<uint16_t>(p); }
+
+// A property's data type is the top nibble of its id.
+uint8_t PropertyType(uint32_t property_id) { return uint8_t(property_id >> 28); }
+
+int64_t ToInt64(const UserData& value) {
+  switch (value.type) {
+    case kTypeInt32:
+      return int32_t(uint32_t(value.bits));
+    case kTypeFloat: {
+      uint32_t raw = uint32_t(value.bits);
+      float f;
+      std::memcpy(&f, &raw, sizeof(f));
+      return int64_t(f);
+    }
+    case kTypeDouble: {
+      double d;
+      std::memcpy(&d, &value.bits, sizeof(d));
+      return int64_t(d);
+    }
+    default:
+      return int64_t(value.bits);
+  }
+}
+
+struct Entry {
+  uint64_t xuid = 0;
+  std::string gamertag;
+  int64_t rating = 0;
+  int64_t time = 0;
+  std::vector<Property> properties;
+
+  const Property* Find(uint32_t id) const {
+    for (const auto& property : properties) {
+      if (property.id == id) return &property;
+    }
+    return nullptr;
+  }
+};
+
+// One leaderboard as the title defines it: which property feeds each column
+// attribute, and which one is the rating the board is sorted by.
+struct ViewSchema {
+  std::map<uint16_t, uint32_t> column_properties;
+  uint32_t rating_property = 0;
+};
+
+// The SPA "XVC2" section (big-endian):
+//   "XVC2", u32 version, u32 size, u16 shared view count
+//   per shared view: u16 column count, u16 row count, 8 reserved bytes,
+//     (columns + rows) field entries - u32 entry size, u32 property id,
+//     u32 flags, u16 attribute id, ... - then an "XPBM" property bitmap
+//     (u32 magic, u32 version, u32 size, 6 reserved bytes, u16 count, ids)
+//   u16 view count; per view: u32 view id, u32 flags, u16 shared view
+//     index, u16 string id, 4 reserved bytes
+std::map<uint32_t, ViewSchema> ParseViewSchema(const uint8_t* data, size_t size) {
+  std::map<uint32_t, ViewSchema> views;
+  const uint8_t* p = data;
+  const uint8_t* end = data + size;
+  auto have = [&](size_t n) { return size_t(end - p) >= n; };
+
+  if (!have(14) || ReadBe32(p) != kXvc2Magic) return views;
+  uint16_t shared_count = ReadBe16(p + 12);
+  p += 14;
+
+  std::vector<ViewSchema> shared;
+  for (uint16_t s = 0; s < shared_count; ++s) {
+    if (!have(12)) return {};
+    uint32_t field_count = uint32_t(ReadBe16(p)) + ReadBe16(p + 2);
+    uint16_t column_count = ReadBe16(p);
+    p += 12;
+    ViewSchema view;
+    for (uint32_t f = 0; f < field_count; ++f) {
+      if (!have(16)) return {};
+      uint32_t entry_size = ReadBe32(p);
+      if (entry_size < 16 || !have(entry_size)) return {};
+      if (f < column_count) {
+        uint32_t property_id = ReadBe32(p + 4);
+        uint16_t attribute_id = ReadBe16(p + 12);
+        view.column_properties[attribute_id] = property_id;
+        if (attribute_id == kAttributeRating) view.rating_property = property_id;
+      }
+      p += entry_size;
+    }
+    if (!have(20) || ReadBe32(p) != kXpbmMagic) return {};
+    size_t bitmap_bytes = 20 + size_t(ReadBe16(p + 18)) * 4;
+    if (!have(bitmap_bytes)) return {};
+    p += bitmap_bytes;
+    shared.push_back(std::move(view));
+  }
+
+  if (!have(2)) return {};
+  uint16_t view_count = ReadBe16(p);
+  p += 2;
+  for (uint16_t v = 0; v < view_count; ++v) {
+    if (!have(16)) return {};
+    uint32_t view_id = ReadBe32(p);
+    uint16_t shared_index = ReadBe16(p + 8);
+    if (shared_index < shared.size()) views[view_id] = shared[shared_index];
+    p += 16;
+  }
+  return views;
+}
+
+std::string HexEncode(const std::string& text) {
+  if (text.empty()) return "-";
+  std::string out;
+  for (unsigned char c : text) out += fmt::format("{:02X}", c);
+  return out;
+}
+
+std::string HexDecode(const std::string& hex) {
+  std::string out;
+  if (hex == "-") return out;
+  for (size_t i = 0; i + 1 < hex.size(); i += 2) {
+    out += char(std::strtoul(hex.substr(i, 2).c_str(), nullptr, 16));
+  }
+  return out;
+}
+
+// Best first; among equal ratings, the earlier entry ranks higher.
+void SortEntries(std::vector<Entry>& entries) {
+  std::stable_sort(entries.begin(), entries.end(), [](const Entry& a, const Entry& b) {
+    return a.rating != b.rating ? a.rating > b.rating : a.time < b.time;
+  });
+  if (entries.size() > kMaxEntriesPerView) entries.resize(kMaxEntriesPerView);
+}
+
+class State {
+ public:
+  static State& Get() {
+    static State state;
+    return state;
+  }
+
+  std::mutex mutex;
+
+  // Everything below is guarded by `mutex`.
+  std::map<uint32_t, std::vector<Entry>> views;
+  std::map<uint32_t, ViewSchema> schema;
+  std::set<uint32_t> empty_enumerations;
+
+  void EnsureLoaded() {
+    if (loaded_) return;
+    auto* kernel_state = REX_KERNEL_STATE();
+    if (!kernel_state) return;
+    loaded_ = true;
+
+    uint32_t title_id = kernel_state->title_id();
+    auto db = kernel_state->title_xdbf();
+    if (db.is_valid()) {
+      auto block = db.GetEntry(system::util::XdbfSection::kMetadata, kXvc2Magic);
+      if (block) schema = ParseViewSchema(block.buffer, block.size);
+    }
+
+    auto* runtime = kernel_state->emulator();
+    if (runtime && !runtime->user_data_root().empty()) {
+      path_ = std::filesystem::absolute(runtime->user_data_root()) / "leaderboards" /
+              fmt::format("{:08X}.txt", title_id);
+      Load();
+    }
+    size_t entry_count = 0;
+    for (const auto& [view_id, entries] : views) entry_count += entries.size();
+    REXKRNL_INFO("Local leaderboards: title {:08X} defines {} view(s); {} saved entr{}",
+                 title_id, schema.size(), entry_count, entry_count == 1 ? "y" : "ies");
+  }
+
+  const ViewSchema* FindSchema(uint32_t view_id) const {
+    auto it = schema.find(view_id);
+    return it != schema.end() ? &it->second : nullptr;
+  }
+
+  const std::vector<Entry>& Entries(uint32_t view_id) const {
+    static const std::vector<Entry> kNone;
+    auto it = views.find(view_id);
+    return it != views.end() ? it->second : kNone;
+  }
+
+  // Written to a temporary file first, so a crash can't truncate the list.
+  void Save() const {
+    if (path_.empty()) return;
+    std::error_code ec;
+    std::filesystem::create_directories(path_.parent_path(), ec);
+    auto temp_path = path_;
+    temp_path += ".tmp";
+    {
+      std::ofstream out(temp_path, std::ios::trunc);
+      if (!out) {
+        REXKRNL_WARN("Local leaderboards: could not write {}", temp_path.string());
+        return;
+      }
+      out << "# Local leaderboards: view xuid rating time gamertag(hex) count "
+             "property:type:value...\n";
+      for (const auto& [view_id, entries] : views) {
+        for (const auto& entry : entries) {
+          out << fmt::format("v {} {:016X} {} {} {} {}", view_id, entry.xuid, entry.rating,
+                             entry.time, HexEncode(entry.gamertag), entry.properties.size());
+          for (const auto& property : entry.properties) {
+            out << fmt::format(" {:08X}:{}:{:016X}", property.id, property.value.type,
+                               property.value.bits);
+          }
+          out << '\n';
+        }
+      }
+    }
+    std::filesystem::rename(temp_path, path_, ec);
+    if (ec) {
+      REXKRNL_WARN("Local leaderboards: could not save {}: {}", path_.string(), ec.message());
+    }
+  }
+
+ private:
+  void Load() {
+    std::ifstream in(path_);
+    std::string line;
+    while (std::getline(in, line)) {
+      if (line.empty() || line[0] == '#') continue;
+      std::istringstream fields(line);
+      std::string tag, xuid, gamertag;
+      uint32_t view_id = 0;
+      size_t count = 0;
+      Entry entry;
+      if (!(fields >> tag >> view_id >> xuid >> entry.rating >> entry.time >> gamertag >> count) ||
+          tag != "v" || count > 256) {
+        continue;
+      }
+      entry.xuid = std::strtoull(xuid.c_str(), nullptr, 16);
+      entry.gamertag = HexDecode(gamertag);
+      for (size_t i = 0; i < count; ++i) {
+        std::string token;
+        unsigned int id = 0, type = 0;
+        unsigned long long bits = 0;
+        if (!(fields >> token) || std::sscanf(token.c_str(), "%x:%u:%llx", &id, &type, &bits) != 3) {
+          break;
+        }
+        entry.properties.push_back({id, {uint8_t(type), bits}});
+      }
+      views[view_id].push_back(std::move(entry));
+    }
+    for (auto& [view_id, entries] : views) SortEntries(entries);
+  }
+
+  bool loaded_ = false;
+  std::filesystem::path path_;
+};
+
+std::string PlayerGamertag(uint64_t xuid) {
+  auto* kernel_state = REX_KERNEL_STATE();
+  if (!kernel_state) return {};
+  const auto& profile = kernel_state->user_profile();
+  if (!profile) return {};
+  // With online play on, the title sees this PC's own Private Match XUID and
+  // name rather than the profile's (netplay.h) and writes its scores under
+  // that one, so both count as the player on this PC.
+  const uint64_t online_xuid = netplay::PlayerXuid(profile->xuid());
+  if (xuid && xuid != profile->xuid() && xuid != online_xuid) return {};
+  // The same name XamUserGetName reports (net_player_name, else the Windows
+  // user name), so a recorded score carries the name the title showed.
+  return netplay::PlayerName(profile->name());
+}
+
+UserData ColumnValue(const Entry* entry, uint32_t rank, const ViewSchema* schema,
+                     uint16_t attribute) {
+  if (attribute == kAttributeRank) return {kTypeInt32, rank};
+  if (attribute == kAttributeRating) {
+    return {kTypeInt64, entry ? uint64_t(entry->rating) : 0};
+  }
+  if (schema) {
+    auto it = schema->column_properties.find(attribute);
+    if (it != schema->column_properties.end()) {
+      if (entry) {
+        if (const auto* property = entry->Find(it->second)) return property->value;
+      }
+      return {PropertyType(it->second), 0};
+    }
+  }
+  return {kTypeNull, 0};
+}
+
+ResultSet::Row MakeRow(const Entry* entry, uint64_t xuid, uint32_t rank, const StatsSpec& spec,
+                       const ViewSchema* schema) {
+  ResultSet::Row row;
+  row.xuid = entry ? entry->xuid : xuid;
+  row.rank = rank;
+  row.rating = entry ? entry->rating : 0;
+  row.gamertag = entry && !entry->gamertag.empty() ? entry->gamertag : PlayerGamertag(row.xuid);
+  for (uint16_t attribute : spec.columns) {
+    row.columns.emplace_back(attribute, ColumnValue(entry, rank, schema, attribute));
+  }
+  return row;
+}
