+
+// ---- Internet play through the online relay server (see netplay.h) --------
+// Wire format: perfect-dark-recomp/tools/relay/pd_relay.py.
+constexpr uint32_t kRelayHello = 0x50445248;    // "PDRH"
+constexpr uint32_t kRelayWelcome = 0x50445257;  // "PDRW"
+constexpr uint32_t kRelayData = 0x50445244;     // "PDRD"
+constexpr uint32_t kRelayError = 0x50445245;    // "PDRE"
+constexpr uint8_t kRelayVersion = 1;
+constexpr uint16_t kRelayDefaultPort = 30760;
+constexpr size_t kRelayMaxPayload = 1500;
+
+struct RelayState {
+  std::mutex listeners_mutex;
+  std::map<uint16_t, RelayReceiver> listeners;
+  socket_t socket = kNoSocket;
+  sockaddr_in server = {};
+  std::string server_text;
+  uint8_t token[8] = {};
+  std::atomic<uint32_t> vip{0};  // network byte order; 0 until the server answers
+  std::atomic<bool> active{false};
+  std::atomic<bool> stop{false};
+  std::atomic<uint32_t> next_port{0};
+  std::atomic<uint64_t> bytes_sent{0};
+  std::atomic<uint64_t> bytes_received{0};
+};
+
+RelayState& Relay() {
+  static RelayState state;
+  return state;
+}
+
+std::string Trimmed(std::string text) {
+  text.erase(0, text.find_first_not_of(" \t"));
+  text.erase(text.find_last_not_of(" \t") + 1);
+  return text;
+}
+
+std::atomic<bool> online_mode{false};
+
+bool RelayConfigured() {
+  // Not cached: online play can be switched on while the game is running.
+  // Only ONLINE uses the relay; LAN and Direct Connect never do.
+  return Enabled() && online_mode && !Trimmed(REXCVAR_GET(net_relay_server)).empty();
+}
+
+std::string RelayRoom() {
+  const std::string room = Trimmed(REXCVAR_GET(net_room));
+  return room.empty() ? std::string("public") : room;
+}
+
+// net_relay_server is "host" or "host:port".
+bool ResolveRelayServer(sockaddr_in* out, std::string* text_out) {
+  std::string text = Trimmed(REXCVAR_GET(net_relay_server));
+  if (text.empty()) {
+    return false;
+  }
+  uint16_t port = kRelayDefaultPort;
+  const size_t colon = text.rfind(':');
+  if (colon != std::string::npos) {
+    port = uint16_t(std::strtoul(text.c_str() + colon + 1, nullptr, 10));
+    text.resize(colon);
+  }
+  addrinfo hints = {};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_DGRAM;
+  addrinfo* list = nullptr;
+  if (port == 0 || getaddrinfo(text.c_str(), nullptr, &hints, &list) != 0 || !list) {
+    return false;
+  }
+  *out = *reinterpret_cast<sockaddr_in*>(list->ai_addr);
+  out->sin_port = htons(port);
+  freeaddrinfo(list);
+  *text_out = text + ":" + std::to_string(port);
+  return true;
+}
+
+void RelaySendRaw(const uint8_t* data, size_t size) {
+  RelayState& r = Relay();
+  sendto(r.socket, reinterpret_cast<const char*>(data), int(size), 0,
+         reinterpret_cast<const sockaddr*>(&r.server), sizeof(r.server));
+  r.bytes_sent += size;
+}
+
+void RelaySendHello() {
+  RelayState& r = Relay();
+  uint8_t hello[52] = {};
+  PutBE32(hello, kRelayHello);
+  hello[4] = kRelayVersion;
+  std::memcpy(hello + 8, r.token, sizeof(r.token));
+  const std::string room = RelayRoom();
+  std::memcpy(hello + 16, room.data(), std::min<size_t>(room.size(), 16));
+  const std::string name = PlayerName(std::string());
+  std::memcpy(hello + 32, name.data(), std::min<size_t>(name.size(), 16));
+  // Asks to keep this address if the server restarted.
+  const uint32_t vip = r.vip;
+  std::memcpy(hello + 48, &vip, 4);
+  RelaySendRaw(hello, sizeof(hello));
+}
+
+void RelayHandle(const uint8_t* p, int n) {
+  RelayState& r = Relay();
+  if (n < 4) {
+    return;
+  }
+  const uint32_t magic = GetBE32(p);
+  if (magic == kRelayData && n >= 12) {
+    uint32_t src;
+    std::memcpy(&src, p + 4, 4);
+    const uint16_t src_port = uint16_t((p[8] << 8) | p[9]);
+    const uint16_t dst_port = uint16_t((p[10] << 8) | p[11]);
+    std::lock_guard<std::mutex> lock(r.listeners_mutex);
+    auto it = r.listeners.find(dst_port);
+    if (it != r.listeners.end()) {
+      it->second(src, src_port, p + 12, size_t(n - 12));
+    }
+    return;
+  }
+  if (magic == kRelayWelcome && n >= 26 && std::memcmp(p + 8, r.token, 8) == 0) {
+    uint32_t vip;
+    std::memcpy(&vip, p + 16, 4);
+    uint32_t public_ip;
+    std::memcpy(&public_ip, p + 20, 4);
+    const uint32_t previous = r.vip.exchange(vip);
+    if (previous != vip) {
+      REXKRNL_INFO("[netplay] online server {}: this PC is {} in room \"{}\" (seen from {}:{})",
+                   r.server_text, FormatIPv4(vip), RelayRoom(), FormatIPv4(public_ip),
+                   (p[24] << 8) | p[25]);
+      if (previous != 0) {
+        REXKRNL_WARN("[netplay] the online server changed this PC's address; rejoin the match");
+      }
+    }
+    return;
+  }
+  if (magic == kRelayError && n >= 5) {
+    const std::string text(reinterpret_cast<const char*>(p + 5), size_t(n - 5));
+    REXKRNL_WARN("[netplay] online server refused: {}", text);
+    PostNotice("Online server: " + text);
+  }
+}
+
+// Keeps the registration alive and hands arriving packets to their listener.
+void RelayThread() {
+  RelayState& r = Relay();
+  auto last_hello = std::chrono::steady_clock::now() - std::chrono::seconds(10);
+  auto last_report = std::chrono::steady_clock::now();
+  uint64_t reported_sent = 0;
+  uint64_t reported_received = 0;
+  std::vector<uint8_t> packet(4096);
+  while (!r.stop) {
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_hello >= std::chrono::milliseconds(r.vip ? 2000 : 500)) {
+      RelaySendHello();
+      last_hello = now;
+    }
+    if (now - last_report >= std::chrono::minutes(1)) {
+      const uint64_t sent = r.bytes_sent;
+      const uint64_t received = r.bytes_received;
+      if (sent - reported_sent > 16384 || received - reported_received > 16384) {
+        REXKRNL_INFO("[netplay] online traffic in the last minute: {} KB sent, {} KB received",
+                     (sent - reported_sent) / 1024, (received - reported_received) / 1024);
+      }
+      reported_sent = sent;
+      reported_received = received;
+      last_report = now;
+    }
+    fd_set readable;
+    FD_ZERO(&readable);
+    FD_SET(r.socket, &readable);
+    timeval timeout = {0, 100 * 1000};
+    if (select(int(r.socket + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+      continue;
+    }
+    sockaddr_in from = {};
+    socklen_t from_len = sizeof(from);
+    const int n = recvfrom(r.socket, reinterpret_cast<char*>(packet.data()), int(packet.size()),
+                           0, reinterpret_cast<sockaddr*>(&from), &from_len);
+    if (n <= 0 || from.sin_addr.s_addr != r.server.sin_addr.s_addr ||
+        from.sin_port != r.server.sin_port) {
+      continue;
+    }
+    r.bytes_received += uint64_t(n);
+    RelayHandle(packet.data(), n);
+  }
+}
+
+// Registers with the online server and waits up to three seconds for this
+// PC's virtual address. False when net_relay_server is empty or the server
+// does not answer; online play then stays on the local network.
+bool RelayStart(uint32_t* vip_out) {
+  RelayState& r = Relay();
+  if (!RelayConfigured()) {
+    return false;
+  }
+  if (r.active) {
+    *vip_out = r.vip;
+    return true;  // already registered; do not start a second thread
+  }
+  if (r.socket != kNoSocket) {
+    // An earlier attempt failed (no server, or no answer). Let its thread go
+    // and start over, rather than leaving two of them on one socket.
+    r.stop = true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(60));
+    closesocket(r.socket);
+    r.socket = kNoSocket;
+    r.stop = false;
+  }
+  if (!ResolveRelayServer(&r.server, &r.server_text)) {
+    REXKRNL_WARN("[netplay] online server \"{}\" not found; online play stays on this network",
+                 REXCVAR_GET(net_relay_server));
+    return false;
+  }
+  r.socket = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (r.socket == kNoSocket) {
+    return false;
+  }
+  if ((ntohl(r.server.sin_addr.s_addr) >> 24) == 127) {
+    // A server on this PC (testing) is reached over loopback, which keeps
+    // Windows Firewall quiet.
+    sockaddr_in local = {};
+    local.sin_family = AF_INET;
+    local.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    bind(r.socket, reinterpret_cast<sockaddr*>(&local), sizeof(local));
+  }
+  RandomBytes(r.token, sizeof(r.token));
+  std::thread(RelayThread).detach();
+  for (int i = 0; i < 60 && !r.vip; ++i) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+  }
+  if (!r.vip) {
+    r.stop = true;
+    REXKRNL_WARN("[netplay] online server {} did not answer; online play stays on this network",
+                 r.server_text);
+    return false;
+  }
+  r.active = true;
+  *vip_out = r.vip;
+  return true;
+}
+
+// A temporary port on the relay's virtual LAN whose packets queue here.
+class RelayInbox {
+ public:
+  RelayInbox() : port_(RelayEphemeralPort()), queue_(std::make_shared<Queue>()) {
+    auto queue = queue_;
+    RelayListen(port_, [queue](uint32_t src, uint16_t, const uint8_t* data, size_t size) {
+      {
+        std::lock_guard<std::mutex> lock(queue->mutex);
+        if (queue->packets.size() < 64) {
+          queue->packets.emplace_back(src, std::vector<uint8_t>(data, data + size));
+        }
+      }
+      queue->cv.notify_one();
+    });
+  }
+  ~RelayInbox() { RelayUnlisten(port_); }
+  RelayInbox(const RelayInbox&) = delete;
+  RelayInbox& operator=(const RelayInbox&) = delete;
+
+  uint16_t port() const { return port_; }
+
+  // The next packet within timeout_ms: its size, or -1.
+  int Receive(int timeout_ms, uint8_t* buf, size_t cap, uint32_t* from) {
+    std::unique_lock<std::mutex> lock(queue_->mutex);
+    queue_->cv.wait_for(lock, std::chrono::milliseconds(timeout_ms),
+                        [this] { return !queue_->packets.empty(); });
+    if (queue_->packets.empty()) {
+      return -1;
+    }
+    auto packet = std::move(queue_->packets.front());
+    queue_->packets.pop_front();
+    *from = packet.first;
+    const size_t size = std::min(cap, packet.second.size());
+    std::memcpy(buf, packet.second.data(), size);
+    return int(size);
+  }
+
+ private:
+  struct Queue {
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<std::pair<uint32_t, std::vector<uint8_t>>> packets;
+  };
+  uint16_t port_;
+  std::shared_ptr<Queue> queue_;
+};
+
+struct Identity {
+  uint8_t enet[6];
+  std::vector<uint32_t> addresses;  // network byte order, preferred first
+};
+
+Identity BuildLocalIdentity();
+
+const Identity& Local() {
+  static std::mutex identity_mutex;
+  static std::unique_ptr<Identity> identity;
+  static uint32_t identity_generation = 0;
+  std::lock_guard<std::mutex> lock(identity_mutex);
+  const uint32_t generation = rex::system::NetplayGeneration();
+  if (!identity || identity_generation != generation) {
+    identity = std::make_unique<Identity>(BuildLocalIdentity());
+    identity_generation = generation;
+  }
+  return *identity;
+}
+
+Identity BuildLocalIdentity() {
+  const Identity identity = [] {
+    EnsureWinsock();
+    Identity id;
+    // The machine ID stays the same for the whole run: the identity is
+    // rebuilt whenever online play is switched on or off, but the title has
+    // already stored the XNADDR it read at boot.
+    static const std::array<uint8_t, 6> machine_id = [] {
+      std::array<uint8_t, 6> enet{};
+      RandomBytes(enet.data(), enet.size());
+      enet[0] = (enet[0] & 0xFC) | 0x02;  // locally administered, unicast
+      return enet;
+    }();
+    std::memcpy(id.enet, machine_id.data(), sizeof(id.enet));
+    uint32_t configured = 0;
+    uint32_t relay_vip = 0;
+    if (RelayStart(&relay_vip)) {
+      id.addresses.push_back(relay_vip);
+    } else if (ParseIPv4(REXCVAR_GET(net_address), &configured)) {
+      id.addresses.push_back(configured);
+    } else {
+      char host[256] = {};
+      addrinfo hints = {};
+      hints.ai_family = AF_INET;
+      addrinfo* list = nullptr;
+      if (gethostname(host, sizeof(host) - 1) == 0 &&
+          getaddrinfo(host, nullptr, &hints, &list) == 0) {
+        for (addrinfo* it = list; it; it = it->ai_next) {
+          const uint32_t ina = reinterpret_cast<sockaddr_in*>(it->ai_addr)->sin_addr.s_addr;
+          const uint32_t h = ntohl(ina);
+          if ((h >> 24) == 127 || (h >> 16) == 0xA9FE) {
+            continue;  // loopback, link-local
+          }
+          if (std::find(id.addresses.begin(), id.addresses.end(), ina) != id.addresses.end()) {
+            continue;
+          }
+          // Radmin VPN (26.0.0.0/8) first: it exists only to reach friends.
+          if ((h >> 24) == 26) {
+            id.addresses.insert(id.addresses.begin(), ina);
+          } else {
+            id.addresses.push_back(ina);
+          }
+        }
+        freeaddrinfo(list);
+      }
+      if (id.addresses.empty()) {
+        id.addresses.push_back(htonl(INADDR_LOOPBACK));
+      }
+      if (id.addresses.size() > kMaxAddresses) {
+        id.addresses.resize(kMaxAddresses);
+      }
+    }
+    std::string text;
+    for (uint32_t ina : id.addresses) {
+      text += (text.empty() ? "" : ", ") + FormatIPv4(ina);
+    }
+    if (Relay().active) {
+      REXKRNL_INFO("[netplay] Private Match addresses: {} (online server {}, room \"{}\")", text,
+                   Relay().server_text, RelayRoom());
+      return id;
+    }
+    std::string broadcasts;
+    for (uint32_t ina : DirectedBroadcasts()) {
+      broadcasts += (broadcasts.empty() ? "" : ", ") + FormatIPv4(ina);
+    }
+    REXKRNL_INFO("[netplay] Private Match addresses: {} (searches also broadcast to: {})", text,
+                 broadcasts.empty() ? std::string("none") : broadcasts);
+    return id;
+  }();
+  return identity;
+}
+
+uint64_t EnetKey(const uint8_t* xnaddr) {
+  uint64_t key = 0;
+  for (int i = 0; i < 6; ++i) {
+    key = (key << 8) | xnaddr[kXnAddrEnet + i];
+  }
+  return key;
+}
+
+void WriteAddressList(uint8_t* online, const std::vector<uint32_t>& addresses) {
+  online[0] = 'P';
+  online[1] = 'D';
+  online[2] = uint8_t(std::min(addresses.size(), kMaxAddresses));
+  for (size_t i = 0; i < online[2]; ++i) {
+    std::memcpy(online + 4 + i * 4, &addresses[i], 4);
+  }
+}
+
+std::vector<uint32_t> Candidates(const uint8_t* xnaddr) {
+  std::vector<uint32_t> result;
+  const uint8_t* online = xnaddr + kXnAddrOnline;
+  if (online[0] == 'P' && online[1] == 'D') {
+    for (size_t i = 0; i < std::min<size_t>(online[2], kMaxAddresses); ++i) {
+      uint32_t ina;
+      std::memcpy(&ina, online + 4 + i * 4, 4);
+      result.push_back(ina);
+    }
+  }
+  if (result.empty()) {
+    uint32_t ina;
+    std::memcpy(&ina, xnaddr + kXnAddrIna, 4);
+    result.push_back(ina);
+  }
+  return result;
+}
+
+std::mutex peers_mutex;
+// Peer XNADDRs by the IN_ADDR the title uses for them.
+std::map<uint32_t, std::array<uint8_t, kXnAddrSize>> peers;
+// Machines (abEnet) and the address a search heard them answer from.
+std::map<uint64_t, uint32_t> reachable;
+
+// A PC told us its own XNADDR in a query it sent from `ina`. Remembering it
+// is what lets InAddrToXnAddr hand the title that PC's real identity later.
+void RecordPeerXnAddr(uint32_t ina, const uint8_t* xnaddr) {
+  if (!ina) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(peers_mutex);
+  std::memcpy(peers[ina].data(), xnaddr, kXnAddrSize);
+  reachable[EnetKey(xnaddr)] = ina;
+}
+
+struct Invite {
+  bool pending = false;
+  uint32_t user_index = 0;
+  std::array<uint8_t, kSessionInfoSize> info{};
+  uint64_t host_xuid = 0;
+};
+
+std::mutex session_mutex;
+bool hosting = false;
+bool joined = false;
+std::array<uint8_t, kSessionInfoSize> hosted_info{};
+std::array<uint8_t, 8> current_kid{};
+Invite invite;
+
+// A hosted match a search heard.
+struct Candidate {
+  std::array<uint8_t, kSessionInfoSize> info{};
+  uint64_t host_xuid = 0;
+  uint32_t host_ina = 0;  // the address it answered from
+  std::string name;
+  // What the host reports for the server browser (older copies: nothing).
+  int players = 0;
+  int max_players = 0;
+  bool in_progress = false;
+  std::string arena;
+  std::string mode;
+  int ping_ms = 0;
+};
+// Several matches answered and the player has not chosen yet.
+std::vector<Candidate> choices;
+uint32_t choice_user_index = 0;
+
+// Server browser results (session_mutex) and what this PC's hosted match
+// reports.
+std::vector<Candidate> browse_results;
+std::atomic<bool> browsing{false};
+uint32_t session_slots = 0;
+bool session_started = false;
+std::mutex details_mutex;
+std::string match_arena;
+std::string match_mode;
+std::mutex traffic_mutex;
+std::map<uint32_t, std::chrono::steady_clock::time_point> peer_traffic;
+
+// Other players this PC has had game traffic from in the last five seconds.
+int ActivePeers() {
+  const auto cutoff = std::chrono::steady_clock::now() - std::chrono::seconds(5);
+  const Identity& self = Local();
+  std::lock_guard<std::mutex> lock(traffic_mutex);
+  int count = 0;
+  for (auto it = peer_traffic.begin(); it != peer_traffic.end();) {
+    if (it->second < cutoff) {
+      it = peer_traffic.erase(it);
+      continue;
+    }
+    if (std::find(self.addresses.begin(), self.addresses.end(), it->first) ==
+        self.addresses.end()) {
+      ++count;
+    }
+    ++it;
+  }
+  return count;
+}
+
+std::mutex qos_mutex;
+std::vector<uint8_t> qos_data;
+
+std::atomic<bool> responder_started{false};
+std::atomic<bool> searching{false};
+// A Join search, and the choice after it, is under way. The lobby opened for
+// it is a host session, but it does not answer other searches meanwhile.
+std::atomic<bool> seeking{false};
+
+std::mutex notice_mutex;
+std::string notice_text;
+bool notice_new = false;
+
+void PostNotice(std::string text) {
+  std::lock_guard<std::mutex> lock(notice_mutex);
+  notice_text = std::move(text);
+  notice_new = true;
+}
+
+// The answer to a search or QoS query that arrived on the discovery port;
+// empty when there is nothing to say (not hosting, a Join search under way,
+// or not a query).
+std::vector<uint8_t> DiscoveryReply(const uint8_t* packet, size_t size, uint32_t from_ina) {
+  std::vector<uint8_t> reply;
+  if (size < 8 || GetBE32(packet + 4) != kProtocolVersion) {
+    return reply;
+  }
+  const uint32_t magic = GetBE32(packet);
+  if (size >= kQueryIdSize && (magic == kQueryMagic || magic == kQosQueryMagic)) {
+    RecordPeerXnAddr(from_ina, packet + 8);
+  }
+  if (GetBE32(packet) == kQosQueryMagic) {
+    reply.resize(12);
+    PutBE32(reply.data(), kQosAnswerMagic);
+    PutBE32(reply.data() + 4, kProtocolVersion);
+    std::lock_guard<std::mutex> lock(qos_mutex);
+    PutBE32(reply.data() + 8, uint32_t(qos_data.size()));
+    reply.insert(reply.end(), qos_data.begin(), qos_data.end());
+    return reply;
+  }
+  if (GetBE32(packet) != kQueryMagic) {
+    return reply;
+  }
+  reply.assign(kAnswerExtSize, 0);
+  uint32_t slots = 0;
+  bool started = false;
+  {
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (!hosting || seeking) {
+      reply.clear();
+      return reply;
+    }
+    std::memcpy(reply.data() + 8, hosted_info.data(), kSessionInfoSize);
+    slots = session_slots;
+    started = session_started;
+  }
+  PutBE32(reply.data(), kAnswerMagic);
+  PutBE32(reply.data() + 4, kProtocolVersion);
+  const auto& profile = REX_KERNEL_STATE()->user_profile();
+  PutBE64(reply.data() + 8 + kSessionInfoSize, PlayerXuid(profile->xuid()));
+  const std::string name = PlayerName(profile->name());
+  std::memcpy(reply.data() + 16 + kSessionInfoSize, name.data(),
+              std::min<size_t>(name.size(), 15));
+  uint8_t* ext = reply.data() + kAnswerSize;
+  ext[0] = uint8_t(std::min(1 + ActivePeers(), 255));
+  ext[1] = uint8_t(std::min<uint32_t>(slots, 255));
+  ext[2] = started ? kAnswerInProgress : 0;
+  {
+    std::lock_guard<std::mutex> lock(details_mutex);
+    std::memcpy(ext + 4, match_arena.data(), std::min<size_t>(match_arena.size(), 19));
+    std::memcpy(ext + 24, match_mode.data(), std::min<size_t>(match_mode.size(), 19));
+  }
+  REXKRNL_INFO("[netplay] answered a Private Match search from {}", FormatIPv4(from_ina));
+  return reply;
+}
+
+void StartResponder() {
+  bool expected = false;
+  if (!responder_started.compare_exchange_strong(expected, true)) {
+    return;
+  }
+  if (RelayActive()) {
+    RelayListen(kDiscoveryPort,
+                [](uint32_t src, uint16_t src_port, const uint8_t* data, size_t size) {
+                  const std::vector<uint8_t> reply = DiscoveryReply(data, size, src);
+                  if (!reply.empty()) {
+                    RelaySend(kDiscoveryPort, src, src_port, reply.data(), reply.size());
+                  }
+                });
+    REXKRNL_INFO("[netplay] answering Private Match searches on the online server");
+    return;
+  }
+  std::thread([] {
+    EnsureWinsock();
+    socket_t s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kNoSocket) {
+      REXKRNL_WARN("[netplay] could not open the Private Match search socket");
+      responder_started = false;
+      return;
+    }
+    sockaddr_in local = {};
+    local.sin_family = AF_INET;
+    local.sin_port = htons(kDiscoveryPort);
+    uint32_t configured = 0;
+    local.sin_addr.s_addr =
+        ParseIPv4(REXCVAR_GET(net_address), &configured) ? configured : htonl(INADDR_ANY);
+    if (bind(s, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+      REXKRNL_WARN("[netplay] could not listen for Private Match searches on UDP {}",
+                   kDiscoveryPort);
+      CloseSocket(s);
+      responder_started = false;
+      return;
+    }
+    REXKRNL_INFO("[netplay] answering Private Match searches on {}:{}",
+                 FormatIPv4(local.sin_addr.s_addr), kDiscoveryPort);
+    for (;;) {
+      uint8_t packet[64];
+      sockaddr_in from = {};
+      socklen_t from_len = sizeof(from);
+      const int received = recvfrom(s, reinterpret_cast<char*>(packet), sizeof(packet), 0,
+                                    reinterpret_cast<sockaddr*>(&from), &from_len);
+      if (received < 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        continue;
+      }
+      const std::vector<uint8_t> reply =
+          DiscoveryReply(packet, size_t(received), from.sin_addr.s_addr);
+      if (!reply.empty()) {
+        sendto(s, reinterpret_cast<const char*>(reply.data()), int(reply.size()), 0,
+               reinterpret_cast<sockaddr*>(&from), from_len);
+      }
+    }
+  }).detach();
+}
+
+// Takes a heard match as the accepted invite. Needs session_mutex.
+void AcceptLocked(const Candidate& match, uint32_t user_index) {
+  invite.pending = true;
+  invite.user_index = user_index;
+  invite.info = match.info;
+  // The host is reachable at the address it answered from.
+  std::memcpy(invite.info.data() + kInfoHost + kXnAddrIna, &match.host_ina, 4);
+  invite.host_xuid = match.host_xuid;
+}
+
+void AnnounceJoin(const Candidate& match) {
+  REXKRNL_INFO("[netplay] joining {}'s Private Match at {}", match.name,
+               FormatIPv4(match.host_ina));
+  PostNotice("Joining " + (match.name.empty() ? std::string("the host") : match.name) +
+             "'s match");
+}
+
+// net_join_address: one or more host addresses separated by commas.
+std::mutex direct_mutex;
+std::string direct_target;
+
+// "host", "host:port" or an IPv4 address -> network-order IPv4 (0 if none).
+uint32_t ResolveHost(std::string text) {
+  text.erase(0, text.find_first_not_of(" \t"));
+  text.erase(text.find_last_not_of(" \t") + 1);
+  const size_t colon = text.rfind(':');
+  if (colon != std::string::npos) {
+    text.resize(colon);
+  }
+  uint32_t ina = 0;
+  if (text.empty() || ParseIPv4(text, &ina)) {
+    return ina;
+  }
+  EnsureWinsock();
+  addrinfo hints = {};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_DGRAM;
+  addrinfo* list = nullptr;
+  if (getaddrinfo(text.c_str(), nullptr, &hints, &list) == 0 && list) {
+    ina = reinterpret_cast<sockaddr_in*>(list->ai_addr)->sin_addr.s_addr;
+    freeaddrinfo(list);
+  }
+  return ina;
+}
+
+bool HasDirectTarget() {
+  std::lock_guard<std::mutex> lock(direct_mutex);
+  return !direct_target.empty();
+}
+
+std::vector<uint32_t> JoinTargets() {
+  std::vector<uint32_t> targets;
+  {
+    std::lock_guard<std::mutex> lock(direct_mutex);
+    if (!direct_target.empty()) {
+      const uint32_t ina = ResolveHost(direct_target);
+      if (ina) {
+        targets.push_back(ina);
+      } else {
+        REXKRNL_WARN("[netplay] Direct Connect: could not resolve \"{}\"", direct_target);
+      }
+      return targets;
+    }
+  }
+  const std::string list = REXCVAR_GET(net_join_address);
+  size_t start = 0;
+  while (start <= list.size()) {
+    size_t end = list.find(',', start);
+    if (end == std::string::npos) {
+      end = list.size();
+    }
+    std::string item = list.substr(start, end - start);
+    item.erase(0, item.find_first_not_of(" \t"));
+    item.erase(item.find_last_not_of(" \t") + 1);
+    uint32_t ina = 0;
+    if (ParseIPv4(item, &ina) &&
+        std::find(targets.begin(), targets.end(), ina) == targets.end()) {
+      targets.push_back(ina);
+    }
+    start = end + 1;
+  }
+  return targets;
+}
+
+// Asks for hosted Private Matches - at each net_join_address host, or by a
+// broadcast from every local address - and collects the answers. One match
+// becomes the accepted invite; several wait for the player's choice. Returns
+// true when an invite is ready.
+// With `browse`, the answers only fill the server browser's list.
+bool Search(uint32_t user_index, bool browse) {
+  EnsureWinsock();
+  const Identity& self = Local();
+  std::vector<uint32_t> targets = JoinTargets();
+  if (targets.empty() && HasDirectTarget()) {
+    // Direct Connect to an address that didn't resolve: that is a failed
+    // connect, not a reason to go and join whatever the LAN has.
+    std::lock_guard<std::mutex> lock(session_mutex);
+    if (browse) {
+      browse_results.clear();
+    } else {
+      seeking = false;
+      PostNotice("Couldn't find that host address");
+    }
+    return false;
+  }
+  const bool direct = !targets.empty();
+  const bool relay = RelayActive();
+
+  // Packet I/O: through the online server, or native sockets on this PC's
+  // networks. receive() gives a packet's size (-1 for nothing yet) and the
+  // address it came from.
+  std::unique_ptr<RelayInbox> inbox;
+  std::function<void(uint32_t, const uint8_t*, size_t)> send_to;
+  std::function<int(int, uint8_t*, size_t, uint32_t*)> receive;
+  std::vector<socket_t> sockets;
+  if (relay) {
+    inbox = std::make_unique<RelayInbox>();
+    send_to = [&](uint32_t ina, const uint8_t* data, size_t size) {
+      RelaySend(inbox->port(), ina, kDiscoveryPort, data, size);
+    };
+    receive = [&](int timeout_ms, uint8_t* buf, size_t cap, uint32_t* from) {
+      return inbox->Receive(timeout_ms, buf, cap, from);
+    };
+  } else {
+    send_to = [&](uint32_t ina, const uint8_t* data, size_t size) {
+      for (socket_t s : sockets) {
+        sockaddr_in target = {};
+        target.sin_family = AF_INET;
+        target.sin_port = htons(kDiscoveryPort);
+        target.sin_addr.s_addr = ina;
+        sendto(s, reinterpret_cast<const char*>(data), int(size), 0,
+               reinterpret_cast<const sockaddr*>(&target), sizeof(target));
+      }
+    };
+    receive = [&](int timeout_ms, uint8_t* buf, size_t cap, uint32_t* from) {
+      fd_set readable;
+      FD_ZERO(&readable);
+      socket_t highest = 0;
+      for (socket_t s : sockets) {
+        FD_SET(s, &readable);
+        highest = std::max(highest, s);
+      }
+      timeval timeout = {0, timeout_ms * 1000};
+      if (sockets.empty() ||
+          select(int(highest + 1), &readable, nullptr, nullptr, &timeout) <= 0) {
+        return -1;
+      }
+      for (socket_t s : sockets) {
+        if (!FD_ISSET(s, &readable)) {
+          continue;
+        }
+        sockaddr_in f = {};
+        socklen_t f_len = sizeof(f);
+        const int n = recvfrom(s, reinterpret_cast<char*>(buf), int(cap), 0,
+                               reinterpret_cast<sockaddr*>(&f), &f_len);
+        if (n >= 0) {
+          *from = f.sin_addr.s_addr;
+          return n;
+        }
+      }
+      return -1;
+    };
+  }
+  auto open = [&](uint32_t bind_ina) {
+    socket_t s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (s == kNoSocket) {
+      return;
+    }
+    int yes = 1;
+    setsockopt(s, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&yes), sizeof(yes));
+    sockaddr_in local = {};
+    local.sin_family = AF_INET;
+    local.sin_addr.s_addr = bind_ina;
+    if (bind(s, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+      CloseSocket(s);
+      return;
+    }
+    sockets.push_back(s);
+  };
+  uint32_t configured = 0;
+  if (relay) {
+    // Nothing to open: the inbox is this search's port on the virtual LAN.
+  } else if (direct) {
+    open(ParseIPv4(REXCVAR_GET(net_address), &configured) ? configured : htonl(INADDR_ANY));
+  } else {
+    // A broadcast leaves through the adapter its socket is bound to.
+    for (uint32_t ina : self.addresses) {
+      open(ina);
+    }
+  }
+  std::string where;
+  if (direct) {
+    for (uint32_t ina : targets) {
+      where += (where.empty() ? "" : ", ") + FormatIPv4(ina);
+    }
+  } else if (relay) {
+    targets.push_back(htonl(INADDR_BROADCAST));
+    where = "the online server (room \"" + RelayRoom() + "\")";
+  } else {
+    targets.push_back(htonl(INADDR_BROADCAST));
+    for (uint32_t ina : DirectedBroadcasts()) {
+      targets.push_back(ina);
+    }
+    where = "the local network (";
+    for (size_t i = 0; i < targets.size(); ++i) {
+      where += (i ? ", " : "") + FormatIPv4(targets[i]);
+    }
+    where += ")";
+  }
+  REXKRNL_INFO("[netplay] searching {} for a Private Match", where);
+
+  uint8_t query[kQueryIdSize] = {};
+  PutBE32(query, kQueryMagic);
+  PutBE32(query + 4, kProtocolVersion);
+  FillLocalXnAddr(query + 8);
+  std::vector<Candidate> found;
+  // Asking hosts directly ends once each has answered.
+  auto everyone_answered = [&] { return direct && found.size() >= targets.size(); };
+  const bool can_send = relay || !sockets.empty();
+  for (int round = 0; round < 4 && !everyone_answered() && can_send; ++round) {
+    // A broadcast listens one more round after the first answer, for other
+    // hosts, then stops.
+    if (!direct && !browse && round >= 2 && !found.empty()) {
+      break;
+    }
+    for (uint32_t ina : targets) {
+      send_to(ina, query, sizeof(query));
+    }
+    const auto sent_at = std::chrono::steady_clock::now();
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(400);
+    while (!everyone_answered() && std::chrono::steady_clock::now() < deadline) {
+      uint8_t answer[kAnswerExtSize + 16];
+      uint32_t from_ina = 0;
+      const int received = receive(100, answer, sizeof(answer), &from_ina);
+      if (received < int(kAnswerSize) || GetBE32(answer) != kAnswerMagic ||
+          GetBE32(answer + 4) != kProtocolVersion) {
+        continue;
+      }
+      const uint8_t* info = answer + 8;
+      if (std::memcmp(info + kInfoHost + kXnAddrEnet, self.enet, sizeof(self.enet)) == 0) {
+        continue;  // our own match
+      }
+      const uint64_t key = EnetKey(info + kInfoHost);
+      if (std::any_of(found.begin(), found.end(), [&](const Candidate& c) {
+            return EnetKey(c.info.data() + kInfoHost) == key;
+          })) {
+        continue;  // the same host answering again
+      }
+      Candidate match;
+      std::memcpy(match.info.data(), info, kSessionInfoSize);
+      match.host_xuid = GetBE64(answer + 8 + kSessionInfoSize);
+      match.host_ina = from_ina;
+      char name[17] = {};
+      std::memcpy(name, answer + 16 + kSessionInfoSize, 16);
+      match.name = name;
+      match.ping_ms = std::max(1, int(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                          std::chrono::steady_clock::now() - sent_at)
+                                          .count()));
+      if (received >= int(kAnswerExtSize)) {
+        const uint8_t* ext = answer + kAnswerSize;
+        match.players = ext[0];
+        match.max_players = ext[1];
+        match.in_progress = (ext[2] & kAnswerInProgress) != 0;
+        char arena[21] = {};
+        char mode[21] = {};
+        std::memcpy(arena, ext + 4, 20);
+        std::memcpy(mode, ext + 24, 20);
+        match.arena = arena;
+        match.mode = mode;
+      }
+      {
+        std::lock_guard<std::mutex> lock(peers_mutex);
+        reachable[key] = match.host_ina;
+      }
+      REXKRNL_INFO("[netplay] found {}'s Private Match at {}", match.name,
+                   FormatIPv4(match.host_ina));
+      found.push_back(std::move(match));
+    }
+  }
+  inbox.reset();
+  for (socket_t s : sockets) {
+    CloseSocket(s);
+  }
+  std::lock_guard<std::mutex> lock(session_mutex);
+  if (browse) {
+    REXKRNL_INFO("[netplay] server browser: {} match(es) on {}", found.size(), where);
+    browse_results = std::move(found);
+    return !browse_results.empty();
+  }
+  if (found.empty()) {
+    seeking = false;
+    REXKRNL_INFO("[netplay] no Private Match answered on {}", where);
+    std::string text = direct  ? "No game answered at " + where
+                       : relay ? std::string("No online match found")
+                               : std::string("No game found on your network");
+    if (hosting) {
+      text += " - friends can join your match instead";
+    }
+    PostNotice(text);
+    return false;
+  }
+  if (found.size() == 1) {
+    AcceptLocked(found[0], user_index);
+    AnnounceJoin(found[0]);
+    return true;
+  }
+  choices = std::move(found);
+  choice_user_index = user_index;
+  REXKRNL_INFO("[netplay] {} Private Matches answered; waiting for the player's choice",
+               choices.size());
+  PostNotice("Found " + std::to_string(choices.size()) + " online matches - choose one");
+  return false;
+}
