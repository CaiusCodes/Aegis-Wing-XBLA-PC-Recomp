+#if REX_PLATFORM_WIN32
+// Lower-case ASCII of an adapter's wide-string name, for keyword matching.
+std::string AdapterText(const wchar_t* text) {
+  std::string out;
+  for (; text && *text; ++text) {
+    const wchar_t c = *text;
+    out += c < 128 ? char(std::tolower(int(c))) : '?';
+  }
+  return out;
+}
