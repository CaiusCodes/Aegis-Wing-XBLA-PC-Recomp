+
+bool RelayRoutes(uint32_t ina) {
+  if (!Relay().active) {
+    return false;
+  }
+  const uint32_t h = ntohl(ina);
+  return (h >> 16) == 0x0A4D || h == INADDR_BROADCAST;
+}
+
+void RelaySend(uint16_t src_port, uint32_t dst_ina, uint16_t dst_port, const uint8_t* data,
+               size_t size) {
+  RelayState& r = Relay();
+  if (!r.active || size > kRelayMaxPayload) {
+    return;
+  }
+  uint8_t packet[20 + kRelayMaxPayload];
+  PutBE32(packet, kRelayData);
+  std::memcpy(packet + 4, r.token, sizeof(r.token));
+  packet[12] = uint8_t(src_port >> 8);
+  packet[13] = uint8_t(src_port);
+  std::memcpy(packet + 14, &dst_ina, 4);
+  packet[18] = uint8_t(dst_port >> 8);
+  packet[19] = uint8_t(dst_port);
+  std::memcpy(packet + 20, data, size);
+  RelaySendRaw(packet, 20 + size);
+}
+
+void RelayListen(uint16_t port, RelayReceiver receiver) {
+  RelayState& r = Relay();
+  std::lock_guard<std::mutex> lock(r.listeners_mutex);
+  r.listeners[port] = std::move(receiver);
+}
+
+void RelayUnlisten(uint16_t port) {
+  RelayState& r = Relay();
+  std::lock_guard<std::mutex> lock(r.listeners_mutex);
+  r.listeners.erase(port);
+}
+
+uint16_t RelayEphemeralPort() {
+  return uint16_t(50000 + Relay().next_port++ % 15000);
+}
+
+bool GetAcceptedInvite(uint32_t user_index, uint8_t* invite_info) {
+  static_cast<void>(user_index);  // there is one local player
+  std::lock_guard<std::mutex> lock(session_mutex);
+  if (!invite.pending) {
+    return false;
+  }
+  std::memset(invite_info, 0, kInviteInfoSize);
+  PutBE64(invite_info + 0, PlayerXuid(REX_KERNEL_STATE()->user_profile()->xuid()));  // invitee
+  PutBE64(invite_info + 8, invite.host_xuid);                            // inviter
+  PutBE32(invite_info + 16, REX_KERNEL_STATE()->title_id());
+  std::memcpy(invite_info + 20, invite.info.data(), kSessionInfoSize);
+  PutBE32(invite_info + 80, 1);  // fFromGameInvite
+  return true;
+}
+
+}  // namespace rex::kernel::xam::netplay
