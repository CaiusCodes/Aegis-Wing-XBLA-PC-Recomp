+constexpr size_t kInfoKey = 44;
+
+constexpr uint32_t kSessionCreateHost = 0x1;  // XSESSION_CREATE_HOST
+constexpr uint32_t kNotificationSystemUi = 0x9;  // XN_SYS_UI
+
+void PutBE32(uint8_t* p, uint32_t v) {
+  p[0] = uint8_t(v >> 24);
+  p[1] = uint8_t(v >> 16);
+  p[2] = uint8_t(v >> 8);
+  p[3] = uint8_t(v);
+}
+
+void PutBE64(uint8_t* p, uint64_t v) {
+  PutBE32(p, uint32_t(v >> 32));
+  PutBE32(p + 4, uint32_t(v));
+}
+
+uint32_t GetBE32(const uint8_t* p) {
+  return (uint32_t(p[0]) << 24) | (uint32_t(p[1]) << 16) | (uint32_t(p[2]) << 8) | p[3];
+}
+
+uint64_t GetBE64(const uint8_t* p) {
+  return (uint64_t(GetBE32(p)) << 32) | GetBE32(p + 4);
+}
+
+// Dotted IPv4 text to an address in network byte order.
+bool ParseIPv4(const std::string& text, uint32_t* ina) {
+  uint32_t parts[4] = {};
+  int part = 0;
+  bool digit = false;
+  for (char c : text) {
+    if (c >= '0' && c <= '9') {
+      parts[part] = parts[part] * 10 + uint32_t(c - '0');
+      if (parts[part] > 255) {
+        return false;
+      }
+      digit = true;
+    } else if (c == '.' && digit && part < 3) {
+      ++part;
+      digit = false;
+    } else {
+      return false;
+    }
+  }
+  if (part != 3 || !digit) {
+    return false;
+  }
+  *ina = htonl((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]);
+  return true;
+}
+
+std::string FormatIPv4(uint32_t ina) {
+  const uint32_t h = ntohl(ina);
+  char text[16];
+  std::snprintf(text, sizeof(text), "%u.%u.%u.%u", h >> 24, (h >> 16) & 0xFF, (h >> 8) & 0xFF,
+                h & 0xFF);
+  return text;
+}
+
+// Two addresses that can reach each other directly: both loopback (copies on
+// one PC), both on Radmin VPN's 26.0.0.0/8, or the same /24.
+bool SameNetwork(uint32_t a, uint32_t b) {
+  const uint32_t ha = ntohl(a);
+  const uint32_t hb = ntohl(b);
+  if ((ha >> 24) == 127 || (hb >> 24) == 127) {
+    return (ha >> 24) == (hb >> 24);
+  }
+  if ((ha >> 24) == 26 && (hb >> 24) == 26) {
+    return true;
+  }
+  if ((ha >> 16) == 0x0A4D && (hb >> 16) == 0x0A4D) {
+    return true;  // the online server's virtual LAN, 10.77.0.0/16
+  }
+  return (ha >> 8) == (hb >> 8);
+}
+
+void EnsureWinsock() {
+#if REX_PLATFORM_WIN32
+  static std::once_flag once;
+  std::call_once(once, [] {
+    WSADATA data;
+    WSAStartup(MAKEWORD(2, 2), &data);
+  });
+#endif
+}
+
+// Each IPv4 adapter's own broadcast address (192.168.1.255, 26.255.255.255 on
+// Radmin VPN, ...), network byte order. Windows sends 255.255.255.255 out of
+// the preferred adapter only, so a search also goes to these to reach friends
+// on a virtual LAN.
+std::vector<uint32_t> DirectedBroadcasts() {
+  std::vector<uint32_t> result;
+#if REX_PLATFORM_WIN32
+  constexpr ULONG kFlags =
+      GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER;
+  ULONG size = 16 * 1024;
+  std::vector<uint8_t> buffer(size);
+  ULONG rc = GetAdaptersAddresses(AF_INET, kFlags, nullptr,
+                                  reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buffer.data()), &size);
+  if (rc == ERROR_BUFFER_OVERFLOW) {
+    buffer.resize(size);
+    rc = GetAdaptersAddresses(AF_INET, kFlags, nullptr,
+                              reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buffer.data()), &size);
+  }
+  if (rc != NO_ERROR) {
+    return result;
+  }
+  for (auto* adapter = reinterpret_cast<IP_ADAPTER_ADDRESSES*>(buffer.data()); adapter;
+       adapter = adapter->Next) {
+    if (adapter->OperStatus != IfOperStatusUp) {
+      continue;
+    }
+    for (auto* u = adapter->FirstUnicastAddress; u; u = u->Next) {
+      if (u->Address.lpSockaddr->sa_family != AF_INET) {
+        continue;
+      }
+      const uint32_t h =
+          ntohl(reinterpret_cast<sockaddr_in*>(u->Address.lpSockaddr)->sin_addr.s_addr);
+      const unsigned prefix = u->OnLinkPrefixLength;
+      if ((h >> 24) == 127 || (h >> 16) == 0xA9FE || prefix == 0 || prefix > 30) {
+        continue;  // loopback, link-local, or no room for a broadcast address
+      }
+      const uint32_t broadcast = htonl(h | (0xFFFFFFFFu >> prefix));
+      if (std::find(result.begin(), result.end(), broadcast) == result.end()) {
+        result.push_back(broadcast);
+      }
+    }
+  }
+#endif
+  return result;
+}
