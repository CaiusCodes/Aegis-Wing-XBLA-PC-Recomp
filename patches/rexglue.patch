+// Every packet, exactly as it happened. The two-second summaries average away
+// the thing that matters: whether packets arrive evenly, or in clumps with
+// holes between them.
+static void LogOnePacket(const char* way, uint32_t ina, uint16_t port, const uint8_t* data,
+                         uint32_t len) {
+  if (!REXCVAR_GET(net_log_packets)) return;
+  std::string head;
+  const uint32_t show = len < 8u ? len : 8u;
+  for (uint32_t i = 0; i < show; ++i) head += fmt::format("{:02X}", data[i]);
+  const uint8_t* a = reinterpret_cast<const uint8_t*>(&ina);
+  REXLOG_INFO("[pkt] {} {}.{}.{}.{}:{} {} bytes {}", way, a[0], a[1], a[2], a[3], port,
+              len, head);
+}
+// Developer trace (netplay::SetPacketTrace, switched on by the title's
+// pd_mp_trace): every game packet with when it happened and both PCs' frame
+// counts, for the title to line up against what it did with them frame by
+// frame. Nothing is queued while it is off.
+namespace {
+std::atomic<bool> g_packet_trace_on{false};
+std::mutex g_packet_trace_mutex;
+std::vector<rex::kernel::xam::netplay::PacketTraceEvent> g_packet_trace;
+}  // namespace
+
+static void NotePacketTrace(bool sent, uint32_t size, uint32_t peer, uint32_t peer_frame) {
+  if (!g_packet_trace_on.load(std::memory_order_relaxed)) return;
+  rex::kernel::xam::netplay::PacketTraceEvent e;
+  e.us = std::chrono::duration_cast<std::chrono::microseconds>(
