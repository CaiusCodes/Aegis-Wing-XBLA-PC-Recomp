+bool XSocket::RebindForNetplay() {
+  namespace netplay = rex::kernel::xam::netplay;
+  if (af_ != AF_INET || type_ != SOCK_DGRAM) {
+    return false;
+  }
+  // On the relay there is nothing to bind: the port is only an address on the
+  // server's virtual LAN.
+  if (netplay::RelayActive()) {
+    bound_port_ = requested_port_;
+    RelayEnsurePort();
+    REXLOG_INFO("[net] port {} moved to the online server's virtual LAN", bound_port_);
+    return true;
+  }
+  // VDP is the title's own layer on top of UDP, as in Initialize.
+  const int proto = proto_ == Protocol::IPPROTO_VDP ? int(Protocol::IPPROTO_UDP) : int(proto_);
+  const uint64_t replacement = socket(AF_INET, SOCK_DGRAM, proto);
+  if (replacement == uint64_t(-1)) {
+    REXLOG_INFO("[net] could not open a replacement socket for port {}", requested_port_);
+    return false;
+  }
+  if (broadcast_socket_) {
+    const int on = 1;
+    setsockopt(replacement, 0xFFFF, 0x0020, reinterpret_cast<const char*>(&on), sizeof(on));
+  }
+  if (nonblocking_) {
+    u_long value = 1;
+    ioctlsocket(replacement, FIONBIO, &value);
+  }
+  // The old socket still holds this port, so it has to go first - two UDP
+  // sockets cannot bind the same address and port.
+  closesocket(native_handle_);
+  native_handle_ = replacement;
+  N_XSOCKADDR_IN name = {};
+  name.sin_family = AF_INET;
+  name.sin_addr = requested_addr_;
+  name.sin_port = requested_port_;
+  ApplyBindRules(&name);
+  if (bind(replacement, reinterpret_cast<sockaddr*>(&name), sizeof(name)) == 0) {
+    bound_ = true;
+    bound_port_ = name.sin_port;
+    REXLOG_INFO("[net] port {} bound again for the online change", uint16_t(name.sin_port));
+    return true;
+  }
+  // Fall back to where it was, so the game is left with a working socket.
+  REXLOG_INFO("[net] could not bind port {} again after the online change", requested_port_);
+  N_XSOCKADDR_IN local = {};
+  local.sin_family = AF_INET;
+  local.sin_addr = uint32_t(INADDR_LOOPBACK);
+  local.sin_port = requested_port_;
+  if (bind(replacement, reinterpret_cast<sockaddr*>(&local), sizeof(local)) == 0) {
+    bound_ = true;
+    bound_port_ = local.sin_port;
+  } else {
+    bound_ = false;
+  }
+  return false;
+}
