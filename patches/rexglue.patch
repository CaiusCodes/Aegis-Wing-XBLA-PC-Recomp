+// UDP port that Private Match searches and answers use.
+constexpr uint16_t kDiscoveryPort = 3076;
+constexpr uint32_t kQueryMagic = 0x50444D51;   // "PDMQ"
+constexpr uint32_t kAnswerMagic = 0x50444D41;  // "PDMA"
+constexpr uint32_t kProtocolVersion = 1;
+// Answer: magic, version, XSESSION_INFO, host XUID, host name.
+constexpr size_t kAnswerSize = 8 + kSessionInfoSize + 8 + 16;
+// Answer extension for the server browser (older copies stop reading at
+// kAnswerSize): players, slots, flags, pad, arena[20], mode[20].
+constexpr size_t kAnswerExtSize = kAnswerSize + 4 + 20 + 20;
+constexpr uint8_t kAnswerInProgress = 0x1;
