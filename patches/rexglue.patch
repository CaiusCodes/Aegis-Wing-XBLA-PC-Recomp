+}
+void TakePacketTrace(std::vector<PacketTraceEvent>* out) {
+  std::lock_guard<std::mutex> lock(g_packet_trace_mutex);
+  out->insert(out->end(), g_packet_trace.begin(), g_packet_trace.end());
+  g_packet_trace.clear();
+}
+}  // namespace rex::kernel::xam::netplay
+
+REXCVAR_DEFINE_BOOL(net_loopback_only, true, "Network",
+                    "Bind guest sockets that ask for any address to loopback only, so the "
+                    "game never needs a firewall exception. Turn off for LAN play.");
+
+namespace {
+
+// Binds a socket the guest never bound to 127.0.0.1 on an ephemeral port.
+// Without this, Windows binds it to every adapter the first time it listens,
+// sends or receives - which raises the same firewall prompt as an explicit
+// "any address" bind. Attempted once per socket; a failure (for example a
+// socket Windows already bound implicitly) is logged and not retried.
+// Private Match traffic trace: the first packets each way, to diagnose
+// connections between copies of the game.
+constexpr int kTraceLimit = 40;
+
+std::string FormatIPv4(uint32_t address);
+
+// Packet timing per peer and direction (net_stats): how evenly the game's
+// packets leave and arrive, to tell uneven delivery from missing smoothing.
+struct NetFlowStats {
+  std::chrono::steady_clock::time_point last{};
+  bool have_last = false;
+  uint64_t packets = 0;
+  uint64_t bytes = 0;
+  double gap_sum_ms = 0.0;
+  double gap_max_ms = 0.0;
+  uint64_t gaps = 0;
+  uint64_t bursts = 0;     // arrived < 2 ms after the previous packet
+  uint64_t late = 0;       // gap more than twice the average so far
+  std::chrono::steady_clock::time_point window{};
+};
+std::mutex g_net_stats_mutex;
+std::map<std::string, NetFlowStats> g_net_stats;
+std::atomic<uint64_t> g_net_polls{0};
+std::atomic<uint64_t> g_net_empty_polls{0};
+
+void NoteNetFlow(bool enabled, const char* dir, uint32_t ina, uint16_t port, uint32_t size) {
+  if (!enabled) return;
+  const auto now = std::chrono::steady_clock::now();
+  std::lock_guard<std::mutex> lock(g_net_stats_mutex);
+  const std::string key =
+      std::string(dir) + " " + FormatIPv4(ina) + ":" + std::to_string(port);
+  NetFlowStats& f = g_net_stats[key];
+  if (f.window.time_since_epoch().count() == 0) f.window = now;
+  if (f.have_last) {
+    const double gap = std::chrono::duration<double, std::milli>(now - f.last).count();
+    const double avg = f.gaps ? f.gap_sum_ms / double(f.gaps) : gap;
+    if (gap < 2.0) ++f.bursts;
+    if (f.gaps && gap > 2.0 * avg) ++f.late;
+    f.gap_sum_ms += gap;
+    ++f.gaps;
+    if (gap > f.gap_max_ms) f.gap_max_ms = gap;
+  }
+  f.last = now;
+  f.have_last = true;
+  ++f.packets;
+  f.bytes += size;
+  const double window = std::chrono::duration<double>(now - f.window).count();
+  if (window >= 2.0) {
+    REXLOG_INFO("[net_stats] {}: {:.1f} packets/s, {:.0f} bytes avg, gap avg {:.1f} ms max {:.1f} "
+                "ms, {} bunched (<2 ms), {} late (>2x avg); game polls {:.0f}/s ({:.0f}% empty)",
+                key, f.packets / window, f.packets ? double(f.bytes) / f.packets : 0.0,
+                f.gaps ? f.gap_sum_ms / f.gaps : 0.0, f.gap_max_ms, f.bursts, f.late,
+                g_net_polls.load() / window,
+                g_net_polls.load() ? 100.0 * g_net_empty_polls.load() / g_net_polls.load() : 0.0);
+    const auto last = f.last;
+    f = NetFlowStats{};
+    f.window = now;
+    f.last = last;
+    f.have_last = true;
+    g_net_polls = 0;
+    g_net_empty_polls = 0;
+  }
+}
+std::atomic<int> traced_sends{0};
+std::atomic<int> traced_recvs{0};
+
+// The address is in network byte order (winsock's s_addr is a macro, so the
+// parameter has another name).
+std::string FormatIPv4(uint32_t address) {
+  const auto* b = reinterpret_cast<const uint8_t*>(&address);
+  return std::to_string(b[0]) + "." + std::to_string(b[1]) + "." + std::to_string(b[2]) + "." +
+         std::to_string(b[3]);
+}
+
+void KeepUnboundSocketLocal(uint64_t handle, int af, bool& bound, uint16_t& bound_port,
+                            const char* reason) {
+  // Private Match plays over the network: an unbound socket is only pinned
+  // when this copy has its own net_address (two copies on one PC).
+  namespace netplay = rex::kernel::xam::netplay;
+  const uint32_t private_address = netplay::ConfiguredAddress();
+  const bool pin = netplay::Enabled() ? private_address != 0 : REXCVAR_GET(net_loopback_only);
+  if (!pin || bound || af != AF_INET) {
+    return;
+  }
+  bound = true;
+  sockaddr_in local = {};
+  local.sin_family = AF_INET;
+  local.sin_addr.s_addr = private_address ? private_address : netplay::LoopbackAddress();
+  local.sin_port = 0;
+  if (bind(handle, reinterpret_cast<sockaddr*>(&local), sizeof(local)) != 0) {
+    REXLOG_INFO("[net] could not keep an unbound socket on {} before {}",
+                FormatIPv4(local.sin_addr.s_addr), reason);
+    return;
+  }
+  socklen_t len = sizeof(local);
+  if (getsockname(handle, reinterpret_cast<sockaddr*>(&local), &len) == 0) {
+    bound_port = ntohs(local.sin_port);
+  }
+  REXLOG_INFO("[net] unbound socket kept on {}:{} before {} (net_loopback_only)",
+              FormatIPv4(local.sin_addr.s_addr), bound_port, reason);
+}
