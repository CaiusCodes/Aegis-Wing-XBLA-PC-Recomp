+constexpr uint32_t kQosQueryMagic = 0x50445151;   // "PDQQ"
+constexpr uint32_t kQosAnswerMagic = 0x50445141;  // "PDQA"
+// A query carries the asking PC's own XNADDR after the 8-byte header, so the
+// PC it asks knows who is talking to it before the title does. A title that
+// hosts a match looks a joiner up by the MAC-like machine ID in its XNADDR,
+// and it can only match if both PCs use the same one; without this the host
+// would have to invent an XNADDR for an address it has only seen packets
+// from, which never matches, and it refuses the join. Copies that send the
+// shorter 8-byte query still work.
+constexpr size_t kQueryIdSize = 8 + kXnAddrSize;
+constexpr size_t kMaxQosData = 1024;
+
+// XNADDR offsets. abOnline carries this PC's IPv4 addresses so a peer can
